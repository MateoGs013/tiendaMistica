RewriteEngine On
RewriteBase /tienda_mistica/admin/

# Redirigir index.php a la raíz del admin
RewriteCond %{THE_REQUEST} ^GET.*index\.php [NC]
RewriteRule ^(.*)index\.php$ /$1 [R=301,L]

# Redirigir raíz del admin a /admin/inicio
RewriteRule ^$ inicio [R=301,L]

# Evitar reescribir archivos y directorios reales
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Regla genérica para páginas simples del admin (ANTES de las especiales)
RewriteRule ^(inicio|duendes|blogs|contactos|pedidos|usuarios)$ $1.php [L,QSA]

# URLs especiales con parámetros
RewriteRule ^duende/crear$ duende_crear.php [L,QSA]
RewriteRule ^duende/editar/([0-9]+)$ duende_editar.php?id=$1 [L,QSA]
RewriteRule ^duende/borrar/([0-9]+)$ actions/duende_borrar_acc.php?id=$1 [L,QSA]

RewriteRule ^blog/crear$ blog_crear.php [L,QSA]
RewriteRule ^blog/editar/([0-9]+)$ blog_editar.php?id=$1 [L,QSA]
RewriteRule ^blog/borrar/([0-9]+)$ actions/blog_borrar_acc.php?id=$1 [L,QSA]

RewriteRule ^contacto/ver/([0-9]+)$ contacto_ver.php?id=$1 [L,QSA]
RewriteRule ^contacto/borrar/([0-9]+)$ actions/contacto_borrar_acc.php?id=$1 [L,QSA]

RewriteRule ^pedido/ver/([0-9]+)$ pedido_ver.php?id=$1 [L,QSA]
RewriteRule ^usuario/crear$ usuario_crear.php [L,QSA]
RewriteRule ^usuario/editar/([0-9]+)$ usuario_editar.php?id=$1 [L,QSA]
